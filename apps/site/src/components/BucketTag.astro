---
/* One of the four buckets as a tag: Delete, Custom software, An agent, A person.
 *
 * `position` is the bucket's place in `home.buckets` (1–4). It picks the
 * tag's colour (mk-tag--n) and its icon, which the use cases page animates as
 * the reader scrolls (marketing.css, USE CASES). The label is the catalog's
 * bucket title, passed in. `as="li"` for the legend, a <span> elsewhere.
 */
import { Ico } from '@forge/ui'
import { BUCKET_ICON } from './bucket-icons.js'

const { position, label, as: Tag = 'span' } = Astro.props
---
<Tag class={`mk-tag mk-tag--${position}`}><Ico name={BUCKET_ICON[position]} size={13} className="mk-tag-icon" />{label}</Tag>
