---
/* A use case's glyph: a 24×24 line drawing of what the agent does (reads a
 * document, matches two records, routes an exception to a person …).
 *
 * The drawing is complete in the HTML. Where scroll-driven animation runs,
 * marketing.css (USE CASES) draws the `g-draw` strokes in as the use case
 * comes into focus (each has pathLength 1, so one dash is the whole stroke)
 * and moves the `g-move` parts; a later `g-draw--2` / `--3` draws after the
 * first. Decorative: the use case's heading says what it is. */
const { name } = Astro.props
---
<svg class="mk-uc-glyph" data-glyph={name} viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'read' && <>
    <path d="M6.5 3.5h7.5l4 4v13h-11.5z M14 3.5v4h4" />
    <path class="g-draw" pathLength="1" d="M9.5 11.5h6" />
    <path class="g-draw g-draw--2" pathLength="1" d="M9.5 14.5h6" />
    <path class="g-draw g-draw--3" pathLength="1" d="M9.5 17.5h3.5" />
  </>}
  {name === 'match' && <>
    <rect class="g-move g-move--l" x="2.5" y="6.5" width="6.5" height="11" rx="1.2" />
    <rect class="g-move g-move--r" x="15" y="6.5" width="6.5" height="11" rx="1.2" />
    <path class="g-draw" pathLength="1" d="M9 12h6" />
  </>}
  {name === 'route' && <>
    <path d="M3.5 12h6" />
    <path class="g-draw" pathLength="1" d="M9.5 12l4.5-5h4" />
    <path class="g-draw g-draw--2" pathLength="1" d="M9.5 12l4.5 5h6" />
    <circle class="g-move g-move--pop" cx="20" cy="7" r="1.8" />
  </>}
  {name === 'chase' && <>
    <g class="g-move g-move--spin">
      <path d="M19 12a7 7 0 1 1-2.05-4.95" />
      <path d="M19.5 4.5v3h-3" />
    </g>
    <path class="g-draw" pathLength="1" d="M12 8.5V12l2.5 1.5" />
  </>}
  {name === 'gather' && <>
    <path d="M3 9.5h6l2 2h10v8.5H3z" />
    <path class="g-move g-move--drop" d="M7 4.5h2.5" />
    <path class="g-move g-move--drop g-move--late" d="M11 3h2.5" />
    <path class="g-move g-move--drop g-move--later" d="M15 4.5h2.5" />
  </>}
  {name === 'draft' && <>
    <path class="g-draw" pathLength="1" d="M3.5 20h10" />
    <path class="g-move g-move--write" d="M15 4.5l4 4L10.5 17l-4.5 1 1-4.5z" />
  </>}
  {name === 'check' && <>
    <g class="g-move g-move--scan">
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M15.5 15.5l5 5" />
    </g>
    <path class="g-draw" pathLength="1" d="M7.8 10.6l2 2 3.4-3.6" />
  </>}
  {name === 'sort' && <>
    <path d="M3 12h4.5" />
    <path class="g-draw" pathLength="1" d="M7.5 12 11 6h9.5" />
    <path class="g-draw g-draw--2" pathLength="1" d="M7.5 12h13" />
    <path class="g-draw g-draw--3" pathLength="1" d="M7.5 12 11 18h9.5" />
  </>}
  {name === 'report' && <>
    <path d="M3.5 20.5h17" />
    <path class="g-draw" pathLength="1" d="M7 20.5V15" />
    <path class="g-draw g-draw--2" pathLength="1" d="M12 20.5V10.5" />
    <path class="g-draw g-draw--3" pathLength="1" d="M17 20.5V6" />
  </>}
  {name === 'track' && <>
    <path class="g-draw" pathLength="1" d="M3.5 18c4.5 0 4-11 8.5-11s4 11 8.5 11" />
    <circle class="g-move g-move--pop" cx="20.5" cy="18" r="1.8" />
  </>}
  {name === 'time' && <>
    <circle cx="12" cy="12" r="8" />
    <path d="M12 12V8" />
    <path class="g-move g-move--hand" d="M12 12h4" />
  </>}
</svg>
