---
/* The one layout. Head, header, main, footer — every public page is this plus
 * a body.
 *
 * Stylesheet order matters, and it is the same order the app uses: tokens, the
 * kit's document defaults, the kit's material, the buttons, then this site's
 * own marketing sheet. The kit ships classNames and no CSS-in-JS, so importing
 * its stylesheets is part of using its markup — a page that renders `.ui-btn`
 * without them renders an unstyled link.
 */
import '@forge/tokens/tokens.css'
import '@forge/ui/base.css'
import '@forge/ui/kit.css'
import '@forge/ui/button.css'
import '../styles/marketing.css'

// The 400 Latin face is on every page above the fold: preload it so the swap
// from the fallback stack is rarely seen. Vite hashes it to the same URL the
// @font-face rule in tokens.css resolves to.
import interTight400 from '@forge/tokens/fonts/inter-tight-latin-400-normal.woff2?url'

import Seo from '../components/Seo.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { useTranslations } from '@forge/i18n'

/* `overlay`: the page's first section sits under the fixed header (the home
   hero), so the header's flow spacer is left out. `pool`: the footer pool's
   clip, for the motion module (the home page only; every page has its poster). */
const { meta, locale, current, overlay = false, pool = null } = Astro.props
const t = useTranslations(locale)
---
<!DOCTYPE html>
<html lang={meta.lang}>
  <head>
    <link rel="preload" href={interTight400} as="font" type="font/woff2" crossorigin />
    <Seo meta={meta} />
  </head>
  <body>
    {/* The first thing keyboard focus reaches, before the header's links. */}
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <Nav locale={locale} current={current} overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} current={current} pool={pool} />
  </body>
</html>
