---
/* The landing page.
 *
 * Section order is the argument: the hero (hand the repetitive work to AI
 * agents, free up more than half of the team's time) → a week, before and after → the
 * problem (the documented process is not the real one) → how we find the real
 * process → sort every step → one process sorted, as an illustration → how an
 * engagement works → built on your systems → who we are (the person who
 * leads the agency) → FAQ → final CTA. Every CTA books a call.
 *
 * The art direction is one image: rain on a raw crystal that shatters into a
 * polished pebble, with the water leaving it as one calm stream; the calendar
 * picks the water up on its two cards, and the footer is the pool it has
 * filled. See docs/LANDING-DESIGN.md.
 * The server HTML is the final, no-JS state: the AFTER poster and the calendar
 * after, with no video. The one <script> at the bottom adds the motion on top.
 * Where scripts run, the hero's CSS starts on the BEFORE rock instead, so the
 * polished pebble (loading underneath) is never seen before the rough rock.
 *
 * There are no case studies, logos, testimonials or numbers here because
 * none exist yet. The calendar and the invoice walkthrough are illustrations
 * and say so on the page.
 *
 * Every string comes from @forge/i18n. Nothing on this page is written here.
 *
 * ONE FILE, EVERY LANGUAGE. `src/pages/index.astro`, `src/pages/es/index.astro`
 * and `src/pages/it/index.astro` are three-line wrappers around this.
 */
import { getImage } from 'astro:assets'
import Base from '../layouts/Base.astro'
import WeekCompare from '../components/WeekCompare.jsx'
import { Button, Ico } from '@forge/ui'
import forge from '@forge/manifest'
import { CATALOGS, useTranslations, useList } from '@forge/i18n'
import { pageMeta } from '@forge/seo/meta'
import media from '../media/media.json'

import beforeL from '../media/hero-before-16x9.jpg'
import afterL from '../media/hero-after-16x9.jpg'
import beforeP from '../media/hero-before-9x16.jpg'
import afterP from '../media/hero-after-9x16.jpg'
import beforeLWebm from '../media/hero-before-16x9.webm?url'
import beforeLMp4 from '../media/hero-before-16x9.mp4?url'
import afterLWebm from '../media/hero-after-16x9.webm?url'
import afterLMp4 from '../media/hero-after-16x9.mp4?url'
import beforePWebm from '../media/hero-before-9x16.webm?url'
import beforePMp4 from '../media/hero-before-9x16.mp4?url'
import afterPWebm from '../media/hero-after-9x16.webm?url'
import afterPMp4 from '../media/hero-after-9x16.mp4?url'
import transitionLWebm from '../media/hero-transition-16x9.webm?url'
import transitionLMp4 from '../media/hero-transition-16x9.mp4?url'
import transitionPWebm from '../media/hero-transition-9x16.webm?url'
import transitionPMp4 from '../media/hero-transition-9x16.mp4?url'
import cardSplashWebm from '../media/card-splash.webm?url'
import cardSplashMp4 from '../media/card-splash.mp4?url'
import cardRimWebm from '../media/card-rim.webm?url'
import cardRimMp4 from '../media/card-rim.mp4?url'
import streamLWebm from '../media/day-stream-16x9.webm?url'
import streamLMp4 from '../media/day-stream-16x9.mp4?url'
import streamLAvif from '../media/day-stream-16x9.avif?url'
import streamLWebp from '../media/day-stream-16x9.webp?url'
import streamPWebm from '../media/day-stream-9x16.webm?url'
import streamPMp4 from '../media/day-stream-9x16.mp4?url'
import streamPAvif from '../media/day-stream-9x16.avif?url'
import streamPWebp from '../media/day-stream-9x16.webp?url'
import poolWebm from '../media/footer-pool.webm?url'
import poolMp4 from '../media/footer-pool.mp4?url'
import poolNarrowWebm from '../media/footer-pool-narrow.webm?url'
import poolNarrowMp4 from '../media/footer-pool-narrow.mp4?url'
import founderPhoto from '../media/founder.webp'

const stoneFiles = import.meta.glob('../media/stones/*.webp', { eager: true, import: 'default' })

const { locale } = Astro.props
const t = useTranslations(locale)
const list = useList(locale)
const discovery = list('home.discovery')
const buckets = list('home.buckets')
const exampleSteps = list('home.exampleSteps')
const steps = list('home.steps')
const systems = list('home.systems')
const faqs = list('home.faqs')
const aboutBody = list('home.about.body')
const day = (CATALOGS[locale] ?? CATALOGS.en).home.day

// The FAQ nodes are built from the SAME list the page renders. Emitting FAQ
// markup for questions a visitor cannot see is a search policy violation.
const meta = pageMeta('home', locale, { faqs })

/* ── Media ──
   Posters are art-directed: the 9:16 rendition below 1:1 aspect, 16:9 above,
   chosen by aspect ratio rather than width. Each is a responsive AVIF set. */
const PORTRAIT = '(max-aspect-ratio: 1/1)'
const avif = (src, widths) => getImage({ src, format: 'avif', widths, quality: 60 })
const poster = async (landscape, portrait) => ({
  l: await avif(landscape, [960, 1600]),
  p: await avif(portrait, [480, 720]),
})
const posters = { before: await poster(beforeL, beforeP), after: await poster(afterL, afterP) }

// Data for motion/ (URLs only, no strings): read from data-* attributes.
const heroData = JSON.stringify({
  before: { l: { webm: beforeLWebm, mp4: beforeLMp4 }, p: { webm: beforePWebm, mp4: beforePMp4 } },
  after: { l: { webm: afterLWebm, mp4: afterLMp4 }, p: { webm: afterPWebm, mp4: afterPMp4 } },
  transition: { l: { webm: transitionLWebm, mp4: transitionLMp4 }, p: { webm: transitionPWebm, mp4: transitionPMp4 } },
  duration: media.hero['16x9'].transition,
})
// The calendar's water (motion/water.js): the BEFORE card's splash strip
// (its source width and edge row), the AFTER card's rim atlas (its pieces),
// and the stream below the hero (its two renditions, and where its stream
// is in the column, which the rim lands on).
const waterData = JSON.stringify({
  before: { webm: cardSplashWebm, mp4: cardSplashMp4, ...media.cards.before },
  rim: { webm: cardRimWebm, mp4: cardRimMp4, ...media.cards.rim },
  stream: { l: { webm: streamLWebm, mp4: streamLMp4 }, p: { webm: streamPWebm, mp4: streamPMp4 }, x: media.stream.x, width: media.stream.width },
})
// How far the portrait clips run on below their 9:16 frame (marketing.css).
const heroStyle = `--hero-extend: ${media.hero['9x16'].extend}`
// Where the hero's stream leaves each rendition (its centre and width, as
// fractions of the hero's media box), and where the stream clip below the
// hero has its stream (fractions of its column) and each rendition's
// aspect, so the clip (.mk-day-stream, marketing.css) takes up exactly
// where the hero's stream is cut off.
const [streamL, streamP] = [media.hero['16x9'].stream, media.hero['9x16'].stream]
const dayStyle = `--stream-lx: ${streamL.x}; --stream-lw: ${streamL.width}; --stream-px: ${streamP.x}; --stream-pw: ${streamP.width}; ` +
  `--cx: ${media.stream.x}; --cw: ${media.stream.width}; --clip-lar: ${media.stream['16x9'].aspect}; --clip-par: ${media.stream['9x16'].aspect}`

// The footer's pool (motion/pool.js): the looping clip over its poster, in
// its two renditions (the full band, and its centre for phones), each with
// its WebM's codec string (10-bit AV1).
const poolData = JSON.stringify({
  wide: { webm: poolWebm, mp4: poolMp4, av1: media.footer.pool.av1 },
  narrow: { webm: poolNarrowWebm, mp4: poolNarrowMp4, av1: media.footer.pool.narrow.av1 },
})

const stone = async (name) => (await getImage({ src: stoneFiles[`../media/stones/${name}.webp`], format: 'webp', width: 160 })).src
const rawStones = await Promise.all([1, 2, 3, 4, 5, 6, 7].map(i => stone(`raw-${i}`)))
const pebbleStones = await Promise.all([1, 2, 3, 4].map(i => stone(`pebble-${i}`)))
// The portrait in "who we are": a cutout on a transparent background.
const founder = await getImage({ src: founderPhoto, format: 'avif', widths: [480, 960], quality: 70 })

const bucketOf = Object.fromEntries(buckets.map((b, i) => [b.title, i + 1]))
---
<Base meta={meta} locale={locale} current="home" overlay pool={poolData}>
  <section class="mk-hero" data-hero data-media={heroData} style={heroStyle}>
    <div class="mk-hero-stage">
      <div class="mk-hero-media" aria-hidden="true">
        <picture class="mk-hero-layer mk-hero-poster mk-hero-poster--after">
          <source media={PORTRAIT} srcset={posters.after.p.srcSet.attribute} sizes="max(100vw, 56.25vh)" type="image/avif" />
          <img src={posters.after.l.src} srcset={posters.after.l.srcSet.attribute} sizes="max(100vw, 177.78vh)"
               alt="" width={1600} height={900} decoding="async" />
        </picture>
        <div class="mk-hero-layer mk-hero-before" data-hero-before>
          <picture class="mk-hero-layer mk-hero-poster mk-hero-poster--before">
            <source media={PORTRAIT} srcset={posters.before.p.srcSet.attribute} sizes="max(100vw, 56.25vh)" type="image/avif" />
            <img src={posters.before.l.src} srcset={posters.before.l.srcSet.attribute} sizes="max(100vw, 177.78vh)"
                 alt="" width={1600} height={900} fetchpriority="high" decoding="async" />
          </picture>
        </div>
      </div>

      <div class="mk-wrap mk-hero-copy">
        <span class="mk-eyebrow">{t('home.eyebrow')}</span>
        <h1>
          <span class="mk-line mk-hero-line mk-hero-line--lead">{t('home.headingLead')}</span>
          {' '}
          <span class="mk-line mk-hero-line mk-hero-line--main">{t('home.heading')}</span>
        </h1>
        <p class="mk-hero-lead">{t('home.lead')}</p>
        <div class="mk-hero-actions">
          <Button as="a" href={forge.brand.bookingUrl} variant="cta" size="lg" pill iconRightName="arrowRight">
            {t('home.ctaPrimary')}
          </Button>
          <Button as="a" href="#how" variant="glass" size="lg" pill>
            {t('home.ctaSecondary')}
          </Button>
        </div>
        <a class="mk-hero-note" href="#about">{t('home.founderNote')}</a>
      </div>
    </div>
  </section>

  <section class="mk-section mk-day" id="day" style={dayStyle}>
    <div class="mk-day-stream" data-stream aria-hidden="true">
      <picture class="mk-day-stream-poster">
        <source media={PORTRAIT} srcset={streamPAvif} type="image/avif" />
        <source media={PORTRAIT} srcset={streamPWebp} type="image/webp" />
        <source srcset={streamLAvif} type="image/avif" />
        <img src={streamLWebp} alt="" width={128} height={3200} loading="lazy" decoding="async" />
      </picture>
    </div>
    <div class="mk-wrap">
      <div class="mk-section-head" data-reveal>
        <h2 class="mk-h2">
          <span class="mk-line mk-line--grey">{day.headingLead}</span>
          {' '}
          <span class="mk-line">{day.heading}</span>
        </h2>
        <p class="mk-lead">{day.lead}</p>
      </div>
      <div data-day data-water={waterData}>
        <WeekCompare copy={day} locale={locale} />
      </div>
    </div>
  </section>

  <section class="mk-section mk-problem">
    {rawStones.map((src, i) => (
      <span class={`mk-stone mk-stone--r${i + 1}`} aria-hidden="true">
        <img src={src} alt="" width={160} height={160} loading="lazy" decoding="async" />
      </span>
    ))}
    <div class="mk-wrap">
      <div class="mk-problem-copy" data-reveal>
        <h2 class="mk-h2">{t('home.problemHeading')}</h2>
        <p class="mk-lead">{t('home.problemLead')}</p>
        <p class="mk-kicker">{t('home.problemKicker')}</p>
      </div>
    </div>
  </section>

  <section class="mk-section" id="how">
    <div class="mk-wrap">
      <div class="mk-section-head" data-reveal>
        <h2 class="mk-h2">{t('home.discoveryHeading')}</h2>
        <p class="mk-lead">{t('home.discoveryLead')}</p>
      </div>
      <ol class="mk-cols" data-reveal>
        {discovery.map((item, i) => (
          <li>
            <span class="mk-num" aria-hidden="true">[{i + 1}]</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mk-section">
    <div class="mk-wrap">
      <div class="mk-section-head" data-reveal>
        <h2 class="mk-h2">{t('home.bucketsHeading')}</h2>
        <p class="mk-lead">{t('home.bucketsLead')}</p>
      </div>
      <ol class="mk-cols" data-reveal>
        {buckets.map((bucket, i) => (
          <li>
            <span class="mk-num" aria-hidden="true">[{i + 1}]</span>
            <h3>{bucket.title}</h3>
            <p>{bucket.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mk-section">
    <div class="mk-wrap">
      <div class="mk-walkthrough">
        <div class="mk-section-head" data-reveal>
          <h2 class="mk-h2">{t('home.exampleHeading')}</h2>
          <p class="mk-lead">{t('home.exampleLead')}</p>
        </div>
        <ol class="mk-steps-list" data-reveal>
          {exampleSteps.map(item => (
            <li>
              <span>{item.step}</span>
              <span class={`mk-tag mk-tag--${bucketOf[item.bucket] ?? 0}`}>{item.bucket}</span>
            </li>
          ))}
        </ol>
        <p class="mk-illustration-note">{t('home.exampleNote')}</p>
      </div>
    </div>
  </section>

  <section class="mk-section">
    {pebbleStones.slice(0, 2).map((src, i) => (
      <span class={`mk-stone mk-stone--p${i + 1}`} aria-hidden="true">
        <img src={src} alt="" width={160} height={160} loading="lazy" decoding="async" />
      </span>
    ))}
    <div class="mk-wrap">
      <div class="mk-section-head" data-reveal>
        <h2 class="mk-h2">{t('home.stepsHeading')}</h2>
        <p class="mk-lead">{t('home.stepsLead')}</p>
      </div>
      <ol class="mk-cols" data-reveal>
        {steps.map((step, i) => (
          <li>
            <span class="mk-num" aria-hidden="true">[{i + 1}]</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="mk-section">
    {pebbleStones.slice(2).map((src, i) => (
      <span class={`mk-stone mk-stone--p${i + 3}`} aria-hidden="true">
        <img src={src} alt="" width={160} height={160} loading="lazy" decoding="async" />
      </span>
    ))}
    <div class="mk-wrap">
      <div class="mk-section-head" data-reveal>
        <h2 class="mk-h2">{t('home.systemsHeading')}</h2>
        <p class="mk-lead">{t('home.systemsLead')}</p>
      </div>
      <ul class="mk-glass-grid">
        {systems.map((point, i) => (
          <li class="mk-glass-card">
            <span class="mk-num" aria-hidden="true">[{i + 1}]</span>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mk-section mk-about" id="about">
    <div class="mk-wrap mk-about-inner">
      <figure class="mk-about-photo" data-reveal>
        <img src={founder.src} srcset={founder.srcSet.attribute} sizes="(max-width: 720px) min(100vw - 40px, 420px), 560px"
             alt={t('home.about.photoAlt')} width={1280} height={1437} loading="lazy" decoding="async" />
      </figure>
      <div class="mk-about-copy" data-reveal>
        <span class="mk-eyebrow">{t('home.about.eyebrow')}</span>
        <h2 class="mk-h2">
          <span class="mk-line mk-line--grey">{t('home.about.headingLead')}</span>
          {' '}
          <span class="mk-line">{t('home.about.heading')}</span>
        </h2>
        {aboutBody.map(paragraph => <p class="mk-about-p">{paragraph}</p>)}
        <div class="mk-about-actions">
          <Button as="a" href={forge.brand.bookingUrl} variant="cta" size="lg" pill iconRightName="arrowRight">
            {t('home.ctaPrimary')}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="mk-section" id="faq">
    <div class="mk-wrap">
      <div class="mk-section-head" data-reveal>
        <span class="mk-eyebrow">{t('home.faqEyebrow')}</span>
        <h2 class="mk-h2">{t('home.faqHeading')}</h2>
      </div>

      {/* A <details> accordion: open state is the element's own, so it works
          with no JavaScript, with the keyboard, and with find-in-page. */}
      <div class="mk-faq">
        {faqs.map((faq) => (
          <details class="mk-faq-item">
            <summary class="mk-faq-q">
              {faq.q}
              <Ico name="plus" size={18} className="mk-faq-icon" />
            </summary>
            <div class="mk-faq-a">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="mk-final">
    <div class="mk-wrap mk-final-inner">
      <div class="mk-final-copy" data-reveal>
        <h2>{t('home.ctaHeading')}</h2>
        <p>{t('home.ctaLead')}</p>
        <div class="mk-final-actions">
          <Button as="a" href={forge.brand.bookingUrl} variant="cta" size="lg" pill iconRightName="arrowRight">
            {t('home.ctaButton')}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../motion/index.js'
</script>
